# Copy to .env.local and fill in. The site runs without any of these
# (empty states / email skipped) — add them as each service is set up.

# ---- Supabase (Phase 2+) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://www.flowmotionpersonaltraining.com

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM=
OWNER_ALERT_EMAIL=

# ---- Mailing list (Kit / ConvertKit — Phase 6) ----
KIT_API_KEY=
KIT_FORM_ID=

# ---- Zapier inbound (Phase 5) ----
ZAPIER_WEBHOOK_SECRET=

# ---- Analytics ----
NEXT_PUBLIC_GA_ID=
